# Form email via Microsoft Graph. Authentication is Vercel OIDC (no secret), so
# sending only works on the Production deployment. Setup: docs/microsoft-graph-mail.md
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Optional. Defaults shown. Exchange RBAC only allows sending as webside@.
CONTACT_MAIL_FROM=webside@centerrahma.no
CONTACT_MAIL_TO=post@centerrahma.no
