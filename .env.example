# Copy to .env.local and fill in. Setup steps: docs/microsoft-graph-mail.md

# Form email via Microsoft Graph (Entra app, client-credentials flow)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
